# ---------------------------------------------------------------------------
# Root .gitignore for EBYET Academy (Node/Express backend + Vite/React frontend)
# Sub-projects (frontend/, server/) have their own .gitignore for stack-specific paths.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
jspm_packages/

# Environment variables (NEVER commit secrets)
# Tracked: .env.example, .env.sample (templates only)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
.env.backup

# Build artifacts
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.pid.lock
*.seed
sessions/

# Caches
.cache/
.parcel-cache/
.npm/
.vite/
.eslintcache
.stylelintcache
.prettiercache

# Coverage / test output
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# IDE / editor
.vscode/
.idea/
.history/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Deploy platforms
.vercel/
.netlify/
.turbo/
.sentryclirc

# Secrets / credentials
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
.aws/
aws-credentials.json
.stripe/

# Backup files (covers *.bak, *.old, AND foo_backup.js style)
*.bak
*.backup
*.old
*_backup.*
*_backup_*
*_old.*

# Local MongoDB dumps
dump/
*.bson
*.bson.gz

# Local DB files
*.db
*.sqlite
*.sqlite3

# Uploads (local dev only; S3 is authoritative in prod)
uploads/
tmp/
temp/
*.tmp
*.temp

# Archives (avoid committing tarballs of the repo)
*.zip
*.tar.gz
*.rar
*.tgz

# Claude Code memory
.claude/

# Misc local state
*.local
.tern-port
.node_repl_history
