# Dependencies
node_modules/

# Vite build output
dist/
.vite/

# TypeScript
*.tsbuildinfo

# Local env
.env
.env.local
.env.*.local

# Generated at build time (uncomment if you decide to stop tracking it)
# public/version.json

# Vite local config
*.local
