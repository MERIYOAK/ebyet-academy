# ---------------------------------------------------------------------------
# Server .gitignore (Node + Express + MongoDB + Socket.IO)
# Shared patterns are in the root .gitignore.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Local env
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Runtime
*.pid
*.pid.lock
sessions/

# Local upload staging (production uploads go to S3)
uploads/
/tmp/uploads/

# Local MongoDB dumps
dump/
*.bson
*.bson.gz

# Profile photos / thumbnails left locally during testing
profile-photos/
thumbnails/
